#!/usr/bin/env bash
# ==============================================================================
# VoiceIsYou 2111261110 — Self-Extracting Linux Setup Installer (.run)
# ==============================================================================
set -euo pipefail

APP_VERSION="2111261110"
APP_NAME="VoiceIsYou $APP_VERSION"

AUTO_YES=0
FORCE_CLI=0
WANT_MENU=1
WANT_BIN=1
WANT_DESKTOP=0
PLAY_AFTER=0
DO_UNINSTALL=0

for arg in "$@"; do
  case "$arg" in
    -y|--yes|--non-interactive)
      AUTO_YES=1
      ;;
    --cli)
      FORCE_CLI=1
      ;;
    --desktop-shortcut)
      WANT_DESKTOP=1
      ;;
    --no-menu)
      WANT_MENU=0
      ;;
    --play)
      PLAY_AFTER=1
      ;;
    --uninstall)
      DO_UNINSTALL=1
      ;;
    -h|--help)
      cat <<EOF
$APP_NAME — Linux Setup

Usage: $(basename "$0") [options]

Options:
  (no flags)           Launch interactive GUI/CLI Setup Wizard
  -y, --yes            Quick non-interactive installation
  --desktop-shortcut   Also place a launcher icon on ~/Desktop
  --play               Launch $APP_NAME immediately after installing
  --cli                Use terminal prompts instead of GUI dialogs
  --uninstall          Uninstall VoiceIsYou from your account
  -h, --help           Show this help message
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $arg (use --help for usage)" >&2
      exit 1
      ;;
  esac
done

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
INSTALL_DIR="$DATA_HOME/voice-is-you"
BIN_DIR="$HOME/.local/bin"
APPS_DIR="$DATA_HOME/applications"
ICON_PNG_DIR="$DATA_HOME/icons/hicolor/256x256/apps"
ICON_SVG_DIR="$DATA_HOME/icons/hicolor/scalable/apps"

if [ "$DO_UNINSTALL" -eq 1 ]; then
  if [ -x "$INSTALL_DIR/voice-is-you-uninstall" ]; then
    exec "$INSTALL_DIR/voice-is-you-uninstall" $([ "$AUTO_YES" -eq 1 ] && echo "--yes" || true)
  else
    rm -rf "$INSTALL_DIR"
    rm -f "$BIN_DIR/voice-is-you" "$BIN_DIR/voice-is-you-uninstall" \
          "$APPS_DIR/voice-is-you.desktop" \
          "$ICON_PNG_DIR/voice-is-you.png" "$ICON_SVG_DIR/voice-is-you.svg" \
          "$HOME/Desktop"/VoiceIsYou*.desktop
    echo "$APP_NAME uninstalled."
    exit 0
  fi
fi

HAS_GUI=0
if [ "$AUTO_YES" -eq 0 ] && [ "$FORCE_CLI" -eq 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
  HAS_GUI=1
fi

if [ "$HAS_GUI" -eq 1 ]; then
  CHOICES="$(zenity --list --checklist \
    --title="$APP_NAME — Linux Setup" \
    --width=540 --height=360 \
    --text="Welcome to the <b>$APP_NAME</b> Installer!\n\nSpeak grammar rules into your microphone to rewrite reality (no sudo required).\nChoose your setup options:" \
    --column="Enable" --column="Key" --column="Option" \
    --hide-column=2 --separator="|" \
    TRUE "MENU" "Add $APP_NAME to Applications Menu" \
    TRUE "BIN" "Add 'voice-is-you' & 'voice-is-you-uninstall' to ~/.local/bin" \
    TRUE "DESKTOP" "Create Desktop shortcut (~/Desktop)" \
    )" || exit 0

  WANT_MENU=0
  WANT_BIN=0
  WANT_DESKTOP=0
  [[ "|$CHOICES|" == *"|MENU|"* ]] && WANT_MENU=1
  [[ "|$CHOICES|" == *"|BIN|"* ]] && WANT_BIN=1
  [[ "|$CHOICES|" == *"|DESKTOP|"* ]] && WANT_DESKTOP=1
elif [ "$AUTO_YES" -eq 0 ]; then
  echo "========================================================"
  echo "  $APP_NAME — Linux Setup"
  echo "========================================================"
  echo "Install location: $INSTALL_DIR"
  echo ""
  if [ -t 0 ]; then
    read -r -p "Continue with installation? [Y/n] " ans
    case "${ans:-Y}" in
      [Nn]*) echo "Setup cancelled."; exit 0 ;;
    esac
    if [ -d "$HOME/Desktop" ]; then
      read -r -p "Create a Desktop shortcut on ~/Desktop? [y/N] " dans
      case "${dans:-N}" in
        [Yy]*) WANT_DESKTOP=1 ;;
      esac
    fi
  fi
fi

echo "Installing $APP_NAME to $INSTALL_DIR ..."
rm -rf "$INSTALL_DIR/app"
mkdir -p "$INSTALL_DIR"

# Extract embedded base64 tar.gz payload after marker line
sed '1,/^__VOICEISYOU_PAYLOAD_BASE64__$/d' "$0" | base64 -d | tar -xzf - -C "$INSTALL_DIR"

chmod +x "$INSTALL_DIR/voice-is-you" "$INSTALL_DIR/voice-is-you-uninstall"

# Install icons
mkdir -p "$ICON_PNG_DIR" "$ICON_SVG_DIR"
cp "$INSTALL_DIR/app/assets/voice-is-you.png" "$ICON_PNG_DIR/voice-is-you.png"
cp "$INSTALL_DIR/app/assets/voice-is-you.svg" "$ICON_SVG_DIR/voice-is-you.svg"

# Symlink CLI launcher & uninstaller
if [ "$WANT_BIN" -eq 1 ]; then
  mkdir -p "$BIN_DIR"
  ln -sf "$INSTALL_DIR/voice-is-you" "$BIN_DIR/voice-is-you"
  ln -sf "$INSTALL_DIR/voice-is-you-uninstall" "$BIN_DIR/voice-is-you-uninstall"
fi

DESKTOP_CONTENT="[Desktop Entry]
Version=1.0
Type=Application
Name=$APP_NAME
GenericName=Voice-Controlled Puzzle Game
Comment=Speak Baba-style grammar rules into your microphone to solve puzzles!
Exec=$INSTALL_DIR/voice-is-you
Icon=$ICON_PNG_DIR/voice-is-you.png
Terminal=false
Categories=Game;LogicGame;
Keywords=baba;voice;microphone;grammar;puzzle;logic;
StartupWMClass=VoiceIsYou
StartupNotify=true
"

if [ "$WANT_MENU" -eq 1 ]; then
  mkdir -p "$APPS_DIR"
  printf "%s" "$DESKTOP_CONTENT" > "$APPS_DIR/voice-is-you.desktop"
  chmod +x "$APPS_DIR/voice-is-you.desktop"
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$APPS_DIR" 2>/dev/null || true
fi

if [ "$WANT_DESKTOP" -eq 1 ] && [ -d "$HOME/Desktop" ]; then
  rm -f "$HOME/Desktop"/VoiceIsYou*.desktop
  SHORTCUT_PATH="$HOME/Desktop/VoiceIsYou $APP_VERSION.desktop"
  printf "%s" "$DESKTOP_CONTENT" > "$SHORTCUT_PATH"
  chmod +x "$SHORTCUT_PATH"
  command -v gio >/dev/null 2>&1 && gio set "$SHORTCUT_PATH" metadata::trusted true 2>/dev/null || true
fi

command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t "$DATA_HOME/icons/hicolor" 2>/dev/null || true

echo ""
echo "Setup complete! ($APP_NAME)"
echo "  • Launch from terminal:  voice-is-you"
echo "  • Launch from App Menu:  $APP_NAME"
echo "  • Uninstall anytime:     voice-is-you-uninstall"

launch_game_detached() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$INSTALL_DIR/voice-is-you" >/dev/null 2>&1
  else
    nohup "$INSTALL_DIR/voice-is-you" >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
}

if [ "$PLAY_AFTER" -eq 1 ]; then
  launch_game_detached
  exit 0
fi

if [ "$HAS_GUI" -eq 1 ]; then
  if zenity --question \
    --title="$APP_NAME Installed!" \
    --width=450 \
    --ok-label="Play Now!" \
    --cancel-label="Finish" \
    --text="<b>$APP_NAME</b> is ready to play!\n\nClick <b>Start Mic</b> (or hold <b>V</b>) in-game to speak grammar rules.\n\nLaunch right now?"; then
    launch_game_detached
  fi
elif [ "$AUTO_YES" -eq 0 ] && [ -t 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
  read -r -p "Launch $APP_NAME now? [Y/n] " play_ans
  case "${play_ans:-Y}" in
    [Nn]*) ;;
    *) launch_game_detached ;;
  esac
fi

exit 0
